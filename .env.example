# Everything is optional. With no keys the lab runs fully local:
# faster-whisper (STT) + Ollama (LLM) + Kokoro (TTS).

# --- Google Gemini (recommended cloud stack) ---
GEMINI_API_KEY=          # from https://aistudio.google.com/apikey — STT, LLM, TTS, embeddings, Gemini Live

# --- Vocal Bridge (the platform the course uses) ---
VOCAL_BRIDGE_API_KEY=    # vb_... from your agent's page at vocalbridgeai.com
VOCAL_BRIDGE_AGENT_ID=   # only for account-wide keys

# --- Other cloud providers (optional; shown under "More providers") ---
OPENAI_API_KEY=          # STT, LLM, TTS, embeddings, Realtime voice-to-voice
ANTHROPIC_API_KEY=       # LLM
GROQ_API_KEY=            # very fast Whisper STT + LLM
DEEPGRAM_API_KEY=        # STT (nova-3) + TTS (Aura)
ELEVENLABS_API_KEY=      # TTS

# --- Real phone calls (lesson 5) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # your Twilio number, e.g. +15551234567
PUBLIC_URL=              # public tunnel to this server, e.g. https://abc123.ngrok-free.app

# --- Local / open-source settings ---
# OLLAMA_MODEL=ministral-3:latest
# OLLAMA_NUM_CTX=8192
# OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# WHISPER_MODEL=base.en           # tiny.en | base.en | small.en | medium.en | large-v3

# --- Gemini model overrides ---
# GEMINI_LLM_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_REASONING_EFFORT=low

# --- Other cloud model overrides ---
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_REALTIME_MODEL=gpt-realtime
# ANTHROPIC_MODEL=claude-haiku-5-5
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
